# ─── Database ────────────────────────────────────────────────
# SQLite file in the repo root. Phase 2 may switch to Postgres;
# SQLAlchemy URL is the swap seam.
DATABASE_URL=sqlite:///./mita.db

# ─── LLM ─────────────────────────────────────────────────────
# OpenAI model fed to `client.chat.completions.parse` in the pipeline.
# Decision #1: match legacy. If unavailable on your account, fall back
# to gpt-4o-mini.
LLM_MODEL=gpt-5-nano

# Decision #6: the OpenAI API key is NOT read from this file by the
# running server — it lives in user_settings.apiKeys.openai (SQLite).
# The `make seed-api-key` helper reads this var and writes it into the
# DB on a dev machine, so you don't have to PATCH /api/settings by hand.
OPENAI_API_KEY=sk-replace-me

# ─── Image storage ───────────────────────────────────────────
IMAGE_STORAGE_DIR=./storage/images
IMAGE_PUBLIC_BASE_URL=/media

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated. Frontend vite dev server is 5173 by default.
CORS_ORIGINS=http://localhost:5173
